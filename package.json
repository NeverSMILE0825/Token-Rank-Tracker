{
  "name": "find-rank",
  "version": "1.0.0",
  "private": true,
  "description": "Live DexScreener trending rank tracker",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "exe": "electron-builder --win portable",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.neversmile.findrank",
    "productName": "Find Rank",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "desktop/**/*",
      "lib/**/*",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Find Rank.exe"
    }
  }
}
